# Local HTTP listener for an HTTPS reverse proxy. Do not expose this port to the Internet.
STUDY_SYNC_BIND=127.0.0.1
STUDY_SYNC_PORT=8787
STUDY_SYNC_DATA=/var/lib/study-planner-sync
# Generate on the server. Never put the access code itself in this file or in Git.
STUDY_SYNC_TOKEN_FILE=/etc/study-planner-sync/token
