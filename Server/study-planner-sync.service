[Unit]
Description=Study Planner private cloud synchronization
After=network.target

[Service]
Type=simple
User=study-planner-sync
Group=study-planner-sync
WorkingDirectory=/opt/study-planner-sync
EnvironmentFile=/etc/study-planner-sync/server.env
ExecStart=/opt/study-planner-sync/start.sh
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/study-planner-sync

[Install]
WantedBy=multi-user.target
