<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#20312E</item>
        <item name="android:textColorSecondary">#60716B</item>
        <item name="android:colorAccent">#286B57</item>
        <item name="android:colorControlActivated">#286B57</item>
        <item name="android:buttonStyle">@style/CompactActionButton</item>
        <item name="android:alertDialogTheme">@style/PlannerDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/PlannerDialogTheme</item>
        <item name="android:windowBackground">#F5F7F8</item>
        <item name="android:statusBarColor">#F5F7F8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">default</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="CompactActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/compact_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/compact_action_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2147483647</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="PlannerDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#286B57</item>
        <item name="android:buttonStyle">@style/CompactActionButton</item>
        <item name="android:buttonBarButtonStyle">@style/CompactActionButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CompactActionButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CompactActionButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/CompactActionButton</item>
    </style>
</resources>
